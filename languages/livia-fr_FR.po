msgid "The Livia guest selector, placed in the page: it leads to the right booking path."
msgstr "Le sélecteur de convives Livia, posé dans la page : il oriente vers le bon parcours de réservation."

#: src/convives/block.json
msgctxt "block keyword"
msgid "guests"
msgstr "convives"

#: src/convives/block.json
#: src/reserver/block.json
msgctxt "block keyword"
msgid "reservation"
msgstr "réservation"

#: src/reserver/block.json
msgctxt "block title"
msgid "Book button"
msgstr "Bouton Réserver"

#: src/reserver/block.json
msgctxt "block description"
msgid "Opens the Livia booking experience: the number of guests, then the right path."
msgstr "Ouvre l'expérience de réservation Livia : le nombre de convives, puis le bon parcours."

#: src/reserver/block.json
msgctxt "block keyword"
msgid "book"
msgstr "réserver"

#: includes/views/experience.php:155
msgctxt "booking experience status"
msgid "On"
msgstr "Active"

#: includes/views/experience.php:157
msgctxt "booking experience status"
msgid "Off"
msgstr "Inactive"

#. translators: 1: name of the conversation's assistant, Livia by default, 2: restaurant name (in French, already preceded by "de" and contracted).
#: includes/class-livia-experience.php:193
#, php-format
msgid "%1$s, %2$s's assistant, prepares your table with you: date, menus, space. She answers you right away, 7 days a week."
msgstr "%1$s, l'assistante %2$s, prépare votre table avec vous : date, menus, espace. Elle vous répond tout de suite, 7j/7."

#. translators: %1$s: name of the conversation's assistant, Livia by default.
#: includes/class-livia-experience.php:195
#: includes/class-livia-experience.php:283
#, php-format
msgid "%1$s, the restaurant's assistant, prepares your table with you: date, menus, space. She answers you right away, 7 days a week."
msgstr "%1$s, l'assistante du restaurant, prépare votre table avec vous : date, menus, espace. Elle vous répond tout de suite, 7j/7."

#: includes/views/experience.php:18
msgid "the address of your booking tool"
msgstr "l'adresse de votre outil de réservation"

#: includes/views/experience.php:19
msgid "the restaurant's e-mail address"
msgstr "l'adresse e-mail du restaurant"

#: includes/views/experience.php:20
msgid "the address of your private hire tool"
msgstr "l'adresse de votre outil de privatisation"

#. translators: 1: restaurant name, 2: fields to fill.
#: includes/views/experience.php:172
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s : %2$s"

#. translators: %s: fields to fill, by restaurant when there are several.
#: includes/views/experience.php:175
#, php-format
msgid "The experience stays off until you fill in %s."
msgstr "L'expérience reste désactivée tant que vous n'avez pas renseigné %s."

#: includes/views/experience.php:24
msgid "Guest selector"
msgstr "Sélecteur de convives"

#: includes/views/experience.php:279
msgid "For the other page builders and the classic editor: they open the window on this restaurant."
msgstr "Pour les autres constructeurs de pages et l'éditeur classique : ils ouvrent la fenêtre sur ce restaurant."

#: includes/views/settings.php:463
msgid "Address available. The page goes online when you save."
msgstr "Adresse disponible. La page se publie à l'enregistrement."

#: includes/views/settings.php:531
msgid "This restaurant has no embedded conversation: the page shows the widget of your Livia booking page. To choose another one, create an embedded conversation in your Livia space."
msgstr "Ce restaurant n'a pas de conversation intégrée : la page affiche le widget de votre page de réservation Livia. Pour en choisir un autre, créez une conversation intégrée dans votre espace Livia."

#: includes/views/settings.php:558
msgid "Preview of the booking experience"
msgstr "Aperçu de l'expérience de réservation"

#: includes/views/settings.php:576
msgid "The preview follows the settings in progress, even before saving. With several restaurants, the window first shows the choice of the restaurant."
msgstr "L'aperçu suit les réglages en cours, même avant l'enregistrement. Avec plusieurs restaurants, la fenêtre montre d'abord le choix du restaurant."

#: includes/class-livia-admin.php:716
msgid "Widget of your Livia booking page"
msgstr "Widget de votre page de réservation Livia"

#: includes/views/settings.php:304
msgid "On desktop"
msgstr "Sur ordinateur"

#: includes/views/settings.php:332
msgid "On phone"
msgstr "Sur téléphone"

#: includes/views/settings.php:334
msgid "The same widget"
msgstr "Le même widget"

#: includes/views/settings.php:335
msgid "A more discreet bubble on phone: choose a compact widget here. Its margins are the ones set in Livia."
msgstr "Une bulle plus discrète sur téléphone : choisissez ici un widget compact. Ses marges sont celles réglées dans Livia."

#. translators: %s: restaurant name.
#: includes/views/experience.php:142
#, php-format
msgid "%s: a value was refused and the saved one is kept. Open this restaurant below to correct it."
msgstr "%s : une valeur a été refusée, la valeur enregistrée est conservée. Ouvrez ce restaurant plus bas pour la corriger."

#: includes/views/settings.php:337
msgid "On the pages where the “Book a table” bar shows, the bubble gives way to the bar."
msgstr "Sur les pages où la barre « Réserver une table » s'affiche, la bulle laisse la place à la barre."

#: includes/class-livia-updater.php:85
msgid "This update is no longer the one Livia offers. Check for updates again, then retry."
msgstr "Cette mise à jour n'est plus celle que propose Livia. Recherchez à nouveau les mises à jour, puis réessayez."

#: includes/class-livia-updater.php:115
msgid "The downloaded update does not carry the Livia signature: it was not installed. Try again later, or download the new version from your Livia space."
msgstr "La mise à jour téléchargée ne porte pas la signature de Livia : elle n'a pas été installée. Réessayez plus tard, ou téléchargez la nouvelle version depuis votre espace Livia."

#: includes/views/settings.php:309
msgid "No bubble chosen"
msgstr "Aucune bulle choisie"

#: includes/views/settings.php:310
msgid "Chosen widget not found"
msgstr "Widget choisi introuvable"

#: includes/class-livia-updater.php:122
msgid "The downloaded update is not the version Livia announces: it was not installed. Check for updates again, then retry."
msgstr "La mise à jour téléchargée n'est pas la version qu'annonce Livia : elle n'a pas été installée. Recherchez à nouveau les mises à jour, puis réessayez."

#: includes/class-livia-updater.php:125
msgid "The downloaded update is not newer than the installed version of the Livia plugin: it was not installed."
msgstr "La mise à jour téléchargée n'est pas plus récente que la version installée de l'extension Livia : elle n'a pas été installée."

#: includes/views/settings.php:318
msgid "The widget chosen for desktop no longer exists in Livia: this restaurant's bubble no longer shows on desktop or on phone. Choose another one and save."
msgstr "Le widget choisi pour l'ordinateur n'existe plus dans Livia : la bulle de ce restaurant ne s'affiche plus ni sur ordinateur ni sur téléphone. Choisissez-en un autre et enregistrez."

#: includes/views/settings.php:317
msgid "The widget chosen for desktop no longer exists in Livia: this restaurant's bubble no longer shows on desktop. Choose another one and save."
msgstr "Le widget choisi pour l'ordinateur n'existe plus dans Livia : la bulle de ce restaurant ne s'affiche plus sur ordinateur. Choisissez-en un autre et enregistrez."

#. translators: 1: widget shown on desktop, 2: widget shown on phone.
#: includes/class-livia-widgets.php:287
#, php-format
msgid "%1$s on desktop, %2$s on phone"
msgstr "%1$s sur ordinateur, %2$s sur téléphone"

#: includes/views/settings.php:316
msgid "The widget chosen for desktop no longer exists in Livia. Choose another one before you turn this restaurant's bubble on, then save."
msgstr "Le widget choisi pour l'ordinateur n'existe plus dans Livia. Choisissez-en un autre avant d'activer la bulle de ce restaurant, puis enregistrez."

#: includes/views/experience.php:31
msgid "The header of your block theme has no menu the plugin can add to. Open Appearance > Editor > Navigation and add a custom link to #reserver, labelled “Book a table”."
msgstr "L'en-tête de votre thème à blocs n'a aucun menu auquel l'extension peut ajouter un lien. Ouvrez Apparence > Éditeur > Navigation et ajoutez un lien personnalisé vers #reserver, intitulé « Réserver une table »."
